# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5435/bookleaf?schema=public"

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# AI providers — server-side only, never exposed to the client.
# Tried in this order; if one fails (outage, rate limit, no credits) the next
# answers. With no keys at all the app still works on rule-based fallbacks.
AI_PROVIDERS="anthropic,gemini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
GEMINI_API_KEY=""            # GOOGLE_API_KEY is accepted as an alias
GEMINI_MODEL="gemini-3.6-flash"

# HTTP
PORT=4000
CORS_ORIGIN="http://localhost:5173"
