# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5435/bookleaf?schema=public"

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Anthropic — server-side only, never exposed to the client.
# If unset, the app still works: AI features fall back to rule-based logic.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# HTTP
PORT=4000
CORS_ORIGIN="http://localhost:5173"
